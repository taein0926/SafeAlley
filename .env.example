# PostgreSQL / PostGIS
POSTGRES_DB=safealley
POSTGRES_USER=safealley
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Published service ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend database connection (the host is the Docker Compose service name)
DB_HOST=database
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=5
ROUTE_SNAP_MAX_DISTANCE_M=500

# Safety score: weighted average of normalized 0-100 component scores.
# Re-run the pipeline after changing these values to refresh stored safety_score.
SAFETY_STREETLIGHT_WEIGHT=0.40
SAFETY_CCTV_WEIGHT=0.40
SAFETY_HELP_POINT_WEIGHT=0.20
# Kept for the legacy OSM fixture loader only.
SAFETY_POPULATION_WEIGHT=0.20

# Safe route cost = distance * distance weight + distance * risk * risk weight
SAFE_ROUTE_DISTANCE_WEIGHT=1.0
SAFE_ROUTE_RISK_WEIGHT=5.0

# Local natural-language parser. No paid API key is required.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:26b
# Allow the first GPU/model warm-up to complete.
OLLAMA_TIMEOUT_SECONDS=300
# Retain the model between searches; cache validated intent only (not routes).
OLLAMA_KEEP_ALIVE=10m
# In-memory, exact-query cache, maximum 128 entries. Set 0 to disable.
OLLAMA_INTENT_CACHE_SECONDS=300

# Optional paid input-time Jev preview; explicit opt-in, never commit the real key.
TYPESAFE_API_KEY=
JEV_PREVIEW_ENABLED=false
JEV_PREVIEW_MIN_CONFIDENCE=0.7

# Place-name fallback after a PostGIS places miss. Results are bounded to the
# loaded OSM road extent and cached in places. Respect the public service policy.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SafeAlley-MVP/0.1
NOMINATIM_TIMEOUT_SECONDS=10

# OpenStreetMap / Overpass collection
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=240
OSM_AREA_NAME=미추홀구
OSM_AREA_ADMIN_LEVEL=6
OSM_USER_AGENT=SafeAlley-MVP/0.1
# PT only: demo assigns deterministic pseudo-random red/yellow/green scores.
# Change to uniform or replace with real safety data before non-demo use.
OSM_SAFETY_SCORE_MODE=demo
OSM_DEFAULT_SAFETY_SCORE=50
OSM_MIN_SEGMENT_LENGTH_M=1

# Reserved for the Cesium map phase. Do not commit a real token.
VITE_CESIUM_ION_TOKEN=

# Requested directly by the browser; this is not proxied by FastAPI/Nginx.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/
# Must match buildings.source. The supplied MOLIT GIS file uses this value.
VITE_BUILDING_SOURCE=molit-gis-building
VITE_SHOW_STREETLIGHTS=true
VITE_SHOW_CCTVS=true
VITE_SHOW_HELP_POINTS=true

# Streetlight-derived analysis. Scores are relative percentiles within this dataset.
STREETLIGHT_SEGMENT_LENGTH_M=20
STREETLIGHT_SEARCH_RADIUS_M=30
STREETLIGHT_SAMPLE_INTERVAL_M=5
# Query optimization only: no candidate falls back to exact KNN.
STREETLIGHT_CANDIDATE_SEARCH_RADIUS_M=500
STREETLIGHT_DISTANCE_WEIGHT=0.40
STREETLIGHT_DENSITY_WEIGHT=0.30
STREETLIGHT_GAP_WEIGHT=0.30

# Legacy optional collector only. The operational CCTV pipeline reads
# data_pipeline/raw/cctvs/cctv_michuhol_ai_ready.geojson and needs no API key.
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_CCTV_API_URL=
# Weather: startup + KMA issue times (02/05/08/11/14/17/20/23 KST) + 15 minutes.
# KASI refreshes at midnight KST; each failed source retries after 5 minutes.
# Official weather collection requires both portal DECODING keys; never VITE_*.
# KMA forecast and KASI sunrise/sunset need separate service approvals.
# Blank grid uses Juan station's fixed WGS84 location converted with the official KMA formula (55,124).
KMA_SERVICE_KEY=
KMA_GRID_NX=
KMA_GRID_NY=
KASI_SERVICE_KEY=
KASI_LOCATION=인천
# Local CPU speech recognition by default. Server VM can use a private GPU STT tunnel.
STT_MODEL=small
STT_REMOTE_URL=
# Legacy API preprocessing only. Not used by the AI-ready GeoJSON loader.
SAFETY_CCTV_PURPOSES=
CCTV_SEARCH_RADIUS_M=30
CCTV_SAMPLE_INTERVAL_M=5
CCTV_CANDIDATE_SEARCH_RADIUS_M=500
CCTV_DISTANCE_WEIGHT=0.40
CCTV_DENSITY_WEIGHT=0.30
CCTV_GAP_WEIGHT=0.30
