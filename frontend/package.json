{
  "name": "safealley-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:cesium": "node --experimental-strip-types --test tests/*.cesium.test.mjs",
    "test:ui": "node tests/run-ui-tests.cjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@cesium/engine": "20.0.0",
    "@cesium/widgets": "13.1.0",
    "@zip.js/zip.js": "2.7.70",
    "cesium": "1.133.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vite-plugin-static-copy": "3.1.2"
  }
}
