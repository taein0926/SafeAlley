# Copy to deployment/.env ON THE SERVER. Do not copy your entire laptop .env.
# This template deliberately cannot start without server-specific settings.
POSTGRES_PASSWORD=
# Official ollama/ollama version tag or sha256 digest approved by the operator.
OLLAMA_IMAGE=ollama/ollama:0.34.4
OLLAMA_MODEL=gemma4:26b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_INTENT_CACHE_SECONDS=300
# Optional paid input-preview service; enable only with operator approval.
TYPESAFE_API_KEY=
JEV_PREVIEW_ENABLED=false
JEV_PREVIEW_MIN_CONFIDENCE=0.7
# Opt-in only; merging these defaults does not switch the operating provider.
INTENT_PREVIEW_PROVIDER=jev
LAYA_PREVIEW_ENABLED=false
LAYA_PREVIEW_URL=http://host.docker.internal:18762
LAYA_CHECKPOINT_SHA256=b3522f4d79391a93d9272bccdd3a8aadec601b11e9a2be3ea248eb58dd49a9da
STT_MODEL=small
STT_REMOTE_URL=
RELEASE_TAG=local

# Default: only the server-local HTTPS proxy can reach the app.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Portal DECODING keys. These belong only on the server, not in VITE_*.
KMA_SERVICE_KEY=
KASI_SERVICE_KEY=
KMA_GRID_NX=
KMA_GRID_NY=
KASI_LOCATION=인천
# Weather uses KMA issue times + 15 minutes; KASI refreshes at midnight KST.

# Must match the safety analysis used to generate the transferred database.
SAFETY_CCTV_WEIGHT=0.40
SAFETY_HELP_POINT_WEIGHT=0.20
SAFE_ROUTE_DISTANCE_WEIGHT=1.0
SAFE_ROUTE_RISK_WEIGHT=5.0
ROUTE_SNAP_MAX_DISTANCE_M=500
NOMINATIM_USER_AGENT=SafeAlley/0.1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/
VITE_BUILDING_SOURCE=molit-gis-building
